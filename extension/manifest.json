{
  "manifest_version": 3,
  "name": "Project VEIL – Deterministic Demo",
  "version": "0.1.0",
  "description": "Local DOM sanitization before a controlled demo request.",
  "action": {
    "default_title": "Run VEIL demo",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "dist/src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
      "js": ["dist/src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["<all_urls>"],
  "permissions": ["activeTab", "tabs", "storage"],
  "web_accessible_resources": [
    {
      "resources": ["assets/models/*", "assets/models/**/*.wasm", "assets/models/tesseract/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
