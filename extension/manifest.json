{
  "manifest_version": 3,
  "name": "Project VEIL – Deterministic Demo",
  "version": "0.1.0",
  "description": "Local DOM sanitization before a controlled demo request.",
  "action": {
    "default_title": "Run VEIL demo"
  },
  "background": {
    "service_worker": "dist/src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8001/*", "http://localhost:8001/*"],
      "js": ["dist/src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://127.0.0.1:8001/*", "http://localhost:8001/*"],
  "permissions": ["activeTab"]
}
